<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium Automation Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="listeners.AllureListener"/>
    </listeners>

    <test name="1 - Super Admin Login" preserve-order="true">
        <classes>
            <class name="tests.superadmin.SuperAdminLoginTest"/>
        </classes>
    </test>

    <test name="2 - Super User Login" preserve-order="true">
        <classes>
            <class name="tests.superuser.SuperUserLoginTest"/>
        </classes>
    </test>

    <test name="3 - Admin Login (Prepaid and Postpaid)" preserve-order="true">
        <classes>
            <class name="tests.admin.AdminLoginTest"/>
        </classes>
    </test>

    <test name="4 - Consumer Login (Prepaid and Postpaid)" preserve-order="true">
        <classes>
            <class name="tests.consumer.ConsumerLoginTest"/>
        </classes>
    </test>

</suite>